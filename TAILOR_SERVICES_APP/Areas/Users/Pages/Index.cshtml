@page
@{
    ViewData["Title"] = "Users";
}

<div class="page-header d-print-none mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="page-title">Users</h2>
        <a href="/users/new" class="btn btn-primary">+ New User</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table id="usersTable" class="table table-vcenter card-table table-hover w-100"></table>
    </div>
</div>


@section Scripts {
    <script>
        const esc = s => String(s ?? "").replace(/[&<>"']/g,
            c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

        $("#usersTable").DataTable({
            processing: true,
            serverSide: true,
            searchDelay: 400,         
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            order: [[0, "asc"]],
            ajax: {
                url: "/api/users/datatable",
                type: "POST",
                contentType: "application/json",
                data: d => JSON.stringify(d)
            },
            columns: [
                { data: "fullName", title: "Full name", render: DataTable.render.text() },
                { data: "email", title: "Email", render: DataTable.render.text() },
                { data: "phoneNumber", title: "Phone", render: DataTable.render.text(), defaultContent: "" },
                {
                    data: "id", title: "Actions", orderable: false, searchable: false,
                    render: id => `<button class="btn btn-sm btn-primary btn-edit" data-id="${esc(id)}">Edit</button>
                                       <button class="btn btn-sm btn-danger btn-delete" data-id="${esc(id)}">Delete</button>`
                }
            ]
        });

        $("#usersTable").on("click", ".btn-edit", function () {
            const id = $(this).data("id");
            // open your Kendo Window / edit page here
        });
    </script>
}