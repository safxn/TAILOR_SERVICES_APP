@page "/users/new"

@Model TAILOR_SERVICES_APP.Areas.Users.Pages.NewModel

<app-stack>
    <form>
        <div class="row">
			<div class="col-sm-3">
				<app-card title="Group" icon="fi-rr-users">
					<app-form-section>
						<app-field col="col-sm-12">
							<label asp-for="Input.Code" class="form-label required"></label>
							<kendo-textbox for="Input.Code" class="form-control" deferred="true" />
							<span asp-validation-for="Input.Code" class="text-danger"></span>
						</app-field>

						<app-field col="col-sm-12">
							<label asp-for="Input.Name" class="form-label required"></label>
							<kendo-textbox for="Input.Name" class="form-control" deferred="true" />
							<span asp-validation-for="Input.Name" class="text-danger"></span>
						</app-field>

						<app-field col="col-sm-12" class="h-100">
							<label asp-for="Input.Description" class="form-label"></label>
							<kendo-textarea for="Input.Description" class="form-control" style="height: 100%; min-height: 10rem;" deferred="true">
							</kendo-textarea>
						</app-field>
					</app-form-section>
				</app-card>
			</div>
        </div>
    </form>
</app-stack>
