@page "/users/new"


@model NewModel

@{
    ViewData["Title"] = "New User";
}

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">New User</h2>
</div>

<form method="post" novalidate>
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.ConcurrencyToken" />
    <div class="row">
        <div class="col-md-6 col-lg-5">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">User</h3>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label required"></label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="Enter full name" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label required"></label>
                        <input asp-for="Input.Email" type="email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label required"></label>
                        <input asp-for="Input.Password" type="password" class="form-control"
                               placeholder="Enter password" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.PhoneNumber" class="form-label"></label>
                        <input asp-for="Input.PhoneNumber" type="tel" class="form-control" placeholder="+968 9xxx xxxx" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card-footer text-end">
                    <a href="/users" class="btn btn-link">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

   <script type="text/javascript">

      $("form").on("submit", async function (e) {
            e.preventDefault();
            const form = this;
            if (!$(form).valid()) return;

            const btn = $(form).find("button[type=submit]").prop("disabled", true);
            try {
                const res = await fetch(location.href, { method: "POST", body: new FormData(form) });
                const result = await res.json();

                if (result.succeeded) {
                    location.href = "/users";
                } else {
                    const msgs = [].concat(result.errors ?? result.messages ?? "Something went wrong.");
                    alert(msgs.join("\n"));
                }
            } catch {
                alert("Server error. Please try again.");
            } finally {
                btn.prop("disabled", false);
            }
        });
   </script>
}